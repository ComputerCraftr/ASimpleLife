static uint64_t bf_native_transfer_kernel_lanes = 0;
static uint64_t bf_native_summary_kernel_lanes = 0;
static uint64_t bf_native_probe_kernel_lanes = 0;
static uint64_t bf_scalar_scan_kernel_lanes = 0;
static uint64_t bf_scalar_add_kernel_lanes = 0;
static uint64_t bf_scalar_clear_set_kernel_lanes = 0;
static uint64_t bf_scalar_transfer_kernel_lanes = 0;
static uint64_t bf_scalar_summary_kernel_lanes = 0;
static uint64_t bf_scalar_probe_kernel_lanes = 0;

#ifndef BF_TEST_WORK_LIMIT
#define BF_TEST_WORK_LIMIT UINT64_C(0)
#endif
#ifndef BF_TEST_SEMANTIC_FUEL_LIMIT
#define BF_TEST_SEMANTIC_FUEL_LIMIT UINT64_C(0)
#endif

int bf_semantic_fuel_enabled(void) {
    return BF_TEST_SEMANTIC_FUEL_LIMIT != 0;
}

void bf_semantic_step(uint64_t represented_steps) {
    if (BF_TEST_SEMANTIC_FUEL_LIMIT != 0 &&
        (represented_steps > BF_TEST_SEMANTIC_FUEL_LIMIT ||
         bf_semantic_steps > BF_TEST_SEMANTIC_FUEL_LIMIT - represented_steps)) {
        fputs("BF_TEST_SEMANTIC_FUEL_REACHED\n", stderr);
        exit(124);
    }
    bf_semantic_steps += represented_steps;
}

void bf_semantic_summary_unsupported(void) {
    if (BF_TEST_SEMANTIC_FUEL_LIMIT != 0) {
        fputs("BF_TEST_SEMANTIC_FUEL_UNSUPPORTED_SUMMARY\n", stderr);
        exit(125);
    }
}

uint64_t bf_bits_mask(unsigned bits) {
    if (bits == 0U) {
        return UINT64_C(0);
    }
    if (bits >= BF_MAX_CELL_BITS) {
        return (UINT64_C(1) << BF_MAX_CELL_BITS) - 1U;
    }
    return (UINT64_C(1) << bits) - 1U;
}

int64_t bf_wrap_from_u64(uint64_t raw, unsigned bits, int signed_cells) {
    if (bits == 0U) {
        return 0;
    }
    raw &= bf_bits_mask(bits);
    if (!signed_cells) {
        return (int64_t)raw;
    }
    if (bits >= BF_MAX_CELL_BITS) {
        uint64_t sign = UINT64_C(1) << 62U;
        if ((raw & sign) == 0) {
            return (int64_t)raw;
        }
        uint64_t mag = raw - sign;
        return (int64_t)mag - (int64_t)sign;
    }
    uint64_t sign = UINT64_C(1) << (bits - 1);
    if ((raw & sign) == 0) {
        return (int64_t)raw;
    }
    return (int64_t)raw - (int64_t)(UINT64_C(1) << bits);
}

uint64_t bf_wrap_to_u64(int64_t value, unsigned bits) {
    if (bits == 0U) {
        return UINT64_C(0);
    }
    return ((uint64_t)value) & bf_bits_mask(bits);
}

int64_t bf_wrap_add(int64_t lhs, int64_t rhs, unsigned bits, int signed_cells) {
    return bf_wrap_from_u64(bf_wrap_to_u64(lhs, bits) + bf_wrap_to_u64(rhs, bits),
                            bits, signed_cells);
}

int64_t bf_wrap_sub(int64_t lhs, int64_t rhs, unsigned bits, int signed_cells) {
    return bf_wrap_from_u64(bf_wrap_to_u64(lhs, bits) - bf_wrap_to_u64(rhs, bits),
                            bits, signed_cells);
}

int64_t bf_wrap_mul(int64_t lhs, int64_t rhs, unsigned bits, int signed_cells) {
    return bf_wrap_from_u64(bf_wrap_to_u64(lhs, bits) * bf_wrap_to_u64(rhs, bits),
                            bits, signed_cells);
}

int64_t bf_wrap_shift_left(int64_t value, unsigned amount, unsigned bits,
                           int signed_cells) {
    if (amount >= 64U) {
        return 0;
    }
    return bf_wrap_from_u64(bf_wrap_to_u64(value, bits) << amount, bits,
                            signed_cells);
}

int64_t bf_wrap_shift_right(int64_t value, unsigned amount, unsigned bits,
                            int signed_cells) {
    if (amount >= 64U) {
        return 0;
    }
    return bf_wrap_from_u64(bf_wrap_to_u64(value, bits) >> amount, bits,
                            signed_cells);
}

ptrdiff_t bf_wrap_ptr(ptrdiff_t ptr, ptrdiff_t delta, ptrdiff_t len) {
    if (len <= 0) {
        return 0;
    }
    ptr %= len;
    if (ptr < 0) {
        ptr += len;
    }
    delta %= len;
    if (delta < 0) {
        delta += len;
    }
    return (ptr + delta) % len;
}

void bf_zero_region(int64_t tape[BF_TAPE_LEN], ptrdiff_t ptr,
                    ptrdiff_t start_offset, size_t len) {
    if (len == 0U)
        return;
    size_t start = (size_t)bf_wrap_ptr(ptr, start_offset, BF_TAPE_LEN);
    size_t first = len;
    if (first > (size_t)BF_TAPE_LEN - start)
        first = (size_t)BF_TAPE_LEN - start;
    memset(&tape[start], 0, first * sizeof(tape[0]));
    if (first < len)
        memset(tape, 0, (len - first) * sizeof(tape[0]));
}

_Noreturn void bf_diverge_forever(void) {
    for (;;) {
        atomic_signal_fence(memory_order_seq_cst);
    }
}

static void bf_test_check_work_limit(void) {
    const uint64_t work_limit = BF_TEST_WORK_LIMIT;
    if (work_limit != 0 &&
        bf_work_dispatches + bf_work_loop_iterations + bf_work_ops >=
            work_limit) {
        fputs("BF_TEST_WORK_LIMIT_REACHED\n", stderr);
        exit(124);
    }
}

void bf_work_dispatch(void) {
    bf_work_dispatches++;
    bf_test_check_work_limit();
}
void bf_work_loop_iter(void) {
    bf_work_loop_iterations++;
    bf_test_check_work_limit();
}
void bf_work_op(void) {
    bf_work_ops++;
    bf_test_check_work_limit();
}

void bf_work_scan_steps(uint64_t steps) {
    bf_work_loop_iterations += steps;
    bf_work_ops += steps;
    bf_test_check_work_limit();
}

typedef ptrdiff_t (*BfScanKernel)(const int64_t *, ptrdiff_t, ptrdiff_t,
                                  ptrdiff_t, uint64_t *);
typedef void (*BfDeltaKernel)(int64_t *, ptrdiff_t, const ptrdiff_t *,
                              const int64_t *, size_t, ptrdiff_t, unsigned, int,
                              unsigned);
typedef void (*BfSetKernel)(int64_t *, ptrdiff_t, const ptrdiff_t *,
                            const int64_t *, size_t, ptrdiff_t);
typedef void (*BfTransferKernel)(int64_t *, ptrdiff_t, int64_t,
                                 const ptrdiff_t *, const int64_t *, size_t,
                                 ptrdiff_t, unsigned, int);
typedef void (*BfSummaryKernel)(int64_t *, ptrdiff_t, const ptrdiff_t *,
                                const int64_t *, const int64_t *,
                                const int64_t *, size_t, ptrdiff_t, unsigned,
                                int);
typedef size_t (*BfProbeKernel)(const uint8_t *, size_t);

enum {
    BF_KERNEL_FAMILY_ADD = 0U,
    BF_KERNEL_FAMILY_TRANSFER = 1U,
    BF_KERNEL_FAMILY_SUMMARY = 2U
};

typedef struct {
    BfScanKernel scan_zero;
    BfDeltaKernel apply_deltas;
    BfSetKernel set_cells;
    BfTransferKernel transfer;
    BfSummaryKernel summary;
    BfProbeKernel first_empty;
} BfKernelSet;

static void bf_count_family(unsigned family, uint64_t lanes, uint64_t batches) {
    if (family == BF_KERNEL_FAMILY_ADD) {
        bf_add_kernel_lanes += lanes;
        bf_add_kernel_batches += batches;
    } else if (family == BF_KERNEL_FAMILY_TRANSFER) {
        bf_transfer_kernel_lanes += lanes;
        bf_transfer_kernel_batches += batches;
    } else {
        bf_summary_kernel_lanes += lanes;
        bf_summary_kernel_batches += batches;
    }
}

#if (BF_HAS_AVX2_KERNEL || BF_HAS_NEON_KERNEL) && !defined(BF_FORCE_SCALAR_KERNEL)
static void bf_count_native_family(unsigned family, uint64_t lanes) {
    if (family == BF_KERNEL_FAMILY_ADD)
        bf_native_add_kernel_lanes += lanes;
    else if (family == BF_KERNEL_FAMILY_TRANSFER)
        bf_native_transfer_kernel_lanes += lanes;
    else
        bf_native_summary_kernel_lanes += lanes;
}
#endif

static void bf_count_scalar_family(unsigned family, uint64_t lanes) {
    if (family == BF_KERNEL_FAMILY_ADD)
        bf_scalar_add_kernel_lanes += lanes;
    else if (family == BF_KERNEL_FAMILY_TRANSFER)
        bf_scalar_transfer_kernel_lanes += lanes;
    else
        bf_scalar_summary_kernel_lanes += lanes;
}

static int bf_offsets_are_disjoint(ptrdiff_t ptr, const ptrdiff_t *offsets,
                                   size_t count, ptrdiff_t len,
                                   ptrdiff_t forbidden) {
    for (size_t i = 0; i < count; ++i) {
        ptrdiff_t lhs = bf_wrap_ptr(ptr, offsets[i], len);
        if (forbidden >= 0 && lhs == forbidden)
            return 0;
        for (size_t j = 0; j < i; ++j) {
            if (lhs == bf_wrap_ptr(ptr, offsets[j], len))
                return 0;
        }
    }
    return 1;
}

static int bf_offsets_are_contiguous(ptrdiff_t ptr, const ptrdiff_t *offsets,
                                     size_t count, ptrdiff_t len) {
    if (count == 0)
        return 1;
    ptrdiff_t start = bf_wrap_ptr(ptr, offsets[0], len);
    if (start > len - (ptrdiff_t)count)
        return 0;
    for (size_t i = 1; i < count; ++i) {
        if (bf_wrap_ptr(ptr, offsets[i], len) != start + (ptrdiff_t)i)
            return 0;
    }
    return 1;
}

static void bf_apply_deltas_scalar(int64_t *tape, ptrdiff_t ptr,
                                   const ptrdiff_t *offsets,
                                   const int64_t *deltas, size_t count,
                                   ptrdiff_t len, unsigned bits,
                                   int signed_cells, unsigned family) {
    bf_count_family(family, (uint64_t)count, count == 0 ? 0 : 1);
    bf_count_scalar_family(family, (uint64_t)count);
    bf_scalar_kernel_lanes += (uint64_t)count;
    for (size_t i = 0; i < count; ++i) {
        ptrdiff_t dst = bf_wrap_ptr(ptr, offsets[i], len);
        tape[dst] = bf_wrap_add(tape[dst], deltas[i], bits, signed_cells);
    }
}

static void bf_set_cells_scalar(int64_t *tape, ptrdiff_t ptr,
                                const ptrdiff_t *offsets,
                                const int64_t *values, size_t count,
                                ptrdiff_t len) {
    bf_clear_set_kernel_lanes += (uint64_t)count;
    bf_clear_set_kernel_batches += count == 0 ? 0 : 1;
    bf_scalar_clear_set_kernel_lanes += (uint64_t)count;
    bf_scalar_kernel_lanes += (uint64_t)count;
    for (size_t i = 0; i < count; ++i)
        tape[bf_wrap_ptr(ptr, offsets[i], len)] = values[i];
}

static void bf_transfer_scalar(int64_t *tape, ptrdiff_t ptr, int64_t source,
                               const ptrdiff_t *offsets,
                               const int64_t *coefficients, size_t count,
                               ptrdiff_t len, unsigned bits,
                               int signed_cells) {
    bf_count_family(BF_KERNEL_FAMILY_TRANSFER, (uint64_t)count,
                    count == 0 ? 0 : 1);
    bf_count_scalar_family(BF_KERNEL_FAMILY_TRANSFER, (uint64_t)count);
    bf_scalar_kernel_lanes += (uint64_t)count;
    for (size_t i = 0; i < count; ++i) {
        ptrdiff_t dst = bf_wrap_ptr(ptr, offsets[i], len);
        int64_t delta = bf_wrap_mul(source, coefficients[i], bits, signed_cells);
        tape[dst] = bf_wrap_add(tape[dst], delta, bits, signed_cells);
    }
}

static void bf_summary_scalar(int64_t *tape, ptrdiff_t ptr,
                              const ptrdiff_t *offsets, const int64_t *lhs,
                              const int64_t *rhs, const int64_t *coefficients,
                              size_t count, ptrdiff_t len, unsigned bits,
                              int signed_cells) {
    bf_count_family(BF_KERNEL_FAMILY_SUMMARY, (uint64_t)count,
                    count == 0 ? 0 : 1);
    bf_count_scalar_family(BF_KERNEL_FAMILY_SUMMARY, (uint64_t)count);
    bf_scalar_kernel_lanes += (uint64_t)count;
    for (size_t i = 0; i < count; ++i) {
        int64_t product = bf_wrap_mul(lhs[i], rhs[i], bits, signed_cells);
        int64_t delta =
            bf_wrap_mul(product, coefficients[i], bits, signed_cells);
        ptrdiff_t dst = bf_wrap_ptr(ptr, offsets[i], len);
        tape[dst] = bf_wrap_add(tape[dst], delta, bits, signed_cells);
    }
}

static size_t bf_first_empty_scalar(const uint8_t *controls, size_t count) {
    bf_probe_kernel_batches += count == 0 ? 0 : 1;
    for (size_t i = 0; i < count; ++i) {
        bf_probe_kernel_lanes++;
        bf_scalar_probe_kernel_lanes++;
        bf_scalar_kernel_lanes++;
        if (controls[i] == 0)
            return i;
    }
    return count;
}

#if BF_HAS_AVX2_KERNEL && !defined(BF_FORCE_SCALAR_KERNEL)
__attribute__((target("avx2")))
static void bf_apply_deltas_avx2(int64_t *tape, ptrdiff_t ptr,
                                 const ptrdiff_t *offsets,
                                 const int64_t *deltas, size_t count,
                                 ptrdiff_t len, unsigned bits,
                                 int signed_cells, unsigned family) {
    size_t i = 0;
    const __m256i mask = _mm256_set1_epi64x((int64_t)bf_bits_mask(bits));
    const __m256i sign = _mm256_set1_epi64x(bits == 0 ? 0 :
                                           (int64_t)(UINT64_C(1) << (bits - 1U)));
    for (; i + 4 <= count; i += 4) {
        int64_t old[4];
        for (size_t lane = 0; lane < 4; ++lane)
            old[lane] = tape[bf_wrap_ptr(ptr, offsets[i + lane], len)];
        __m256i raw = _mm256_add_epi64(
            _mm256_loadu_si256((const __m256i *)old),
            _mm256_loadu_si256((const __m256i *)&deltas[i]));
        raw = _mm256_and_si256(raw, mask);
        if (signed_cells && bits != 0U)
            raw = _mm256_sub_epi64(_mm256_xor_si256(raw, sign), sign);
        _mm256_storeu_si256((__m256i *)old, raw);
        for (size_t lane = 0; lane < 4; ++lane)
            tape[bf_wrap_ptr(ptr, offsets[i + lane], len)] = old[lane];
        bf_native_avx2_lanes += 4;
        bf_kernel_batches++;
        bf_count_family(family, 4, 1);
        bf_count_native_family(family, 4);
    }
    if (i != count)
        bf_apply_deltas_scalar(tape, ptr, &offsets[i], &deltas[i], count - i,
                               len, bits, signed_cells, family);
}

__attribute__((target("avx2")))
static void bf_set_cells_avx2(int64_t *tape, ptrdiff_t ptr,
                              const ptrdiff_t *offsets,
                              const int64_t *values, size_t count,
                              ptrdiff_t len) {
    size_t i = 0;
    for (; i + 4 <= count; i += 4) {
        ptrdiff_t dst = bf_wrap_ptr(ptr, offsets[i], len);
        _mm256_storeu_si256((__m256i *)&tape[dst],
                            _mm256_loadu_si256((const __m256i *)&values[i]));
        bf_native_avx2_lanes += 4;
        bf_kernel_batches++;
        bf_clear_set_kernel_lanes += 4;
        bf_clear_set_kernel_batches++;
        bf_native_clear_set_kernel_lanes += 4;
    }
    if (i != count)
        bf_set_cells_scalar(tape, ptr, &offsets[i], &values[i], count - i, len);
}

__attribute__((target("avx2")))
static void bf_transfer_avx2(int64_t *tape, ptrdiff_t ptr, int64_t source,
                             const ptrdiff_t *offsets,
                             const int64_t *coefficients, size_t count,
                             ptrdiff_t len, unsigned bits,
                             int signed_cells) {
    if (bits > 32U) {
        bf_transfer_scalar(tape, ptr, source, offsets, coefficients, count, len,
                           bits, signed_cells);
        return;
    }
    size_t i = 0;
    const __m256i source_lanes =
        _mm256_set1_epi64x((int64_t)bf_wrap_to_u64(source, bits));
    const __m256i mask = _mm256_set1_epi64x((int64_t)bf_bits_mask(bits));
    const __m256i sign = _mm256_set1_epi64x(
        bits == 0 ? 0 : (int64_t)(UINT64_C(1) << (bits - 1U)));
    for (; i + 4 <= count; i += 4) {
        int64_t old[4];
        uint64_t raw_coefficients[4];
        for (size_t lane = 0; lane < 4; ++lane) {
            old[lane] = tape[bf_wrap_ptr(ptr, offsets[i + lane], len)];
            raw_coefficients[lane] = bf_wrap_to_u64(coefficients[i + lane], bits);
        }
        __m256i product = _mm256_mul_epu32(
            source_lanes,
            _mm256_loadu_si256((const __m256i *)raw_coefficients));
        __m256i raw = _mm256_and_si256(
            _mm256_add_epi64(_mm256_loadu_si256((const __m256i *)old), product),
            mask);
        if (signed_cells && bits != 0U)
            raw = _mm256_sub_epi64(_mm256_xor_si256(raw, sign), sign);
        _mm256_storeu_si256((__m256i *)old, raw);
        for (size_t lane = 0; lane < 4; ++lane)
            tape[bf_wrap_ptr(ptr, offsets[i + lane], len)] = old[lane];
        bf_native_avx2_lanes += 4;
        bf_kernel_batches++;
        bf_count_family(BF_KERNEL_FAMILY_TRANSFER, 4, 1);
        bf_count_native_family(BF_KERNEL_FAMILY_TRANSFER, 4);
    }
    if (i != count)
        bf_transfer_scalar(tape, ptr, source, &offsets[i], &coefficients[i],
                           count - i, len, bits, signed_cells);
}

__attribute__((target("avx2")))
static void bf_summary_avx2(int64_t *tape, ptrdiff_t ptr,
                            const ptrdiff_t *offsets, const int64_t *lhs,
                            const int64_t *rhs, const int64_t *coefficients,
                            size_t count, ptrdiff_t len, unsigned bits,
                            int signed_cells) {
    if (bits > 32U) {
        bf_summary_scalar(tape, ptr, offsets, lhs, rhs, coefficients, count, len,
                          bits, signed_cells);
        return;
    }
    size_t i = 0;
    const __m256i mask = _mm256_set1_epi64x((int64_t)bf_bits_mask(bits));
    const __m256i sign = _mm256_set1_epi64x(
        bits == 0 ? 0 : (int64_t)(UINT64_C(1) << (bits - 1U)));
    for (; i + 4 <= count; i += 4) {
        int64_t old[4];
        uint64_t raw_lhs[4];
        uint64_t raw_rhs[4];
        uint64_t raw_coefficients[4];
        for (size_t lane = 0; lane < 4; ++lane) {
            old[lane] = tape[bf_wrap_ptr(ptr, offsets[i + lane], len)];
            raw_lhs[lane] = bf_wrap_to_u64(lhs[i + lane], bits);
            raw_rhs[lane] = bf_wrap_to_u64(rhs[i + lane], bits);
            raw_coefficients[lane] =
                bf_wrap_to_u64(coefficients[i + lane], bits);
        }
        __m256i product = _mm256_mul_epu32(
            _mm256_loadu_si256((const __m256i *)raw_lhs),
            _mm256_loadu_si256((const __m256i *)raw_rhs));
        product = _mm256_mul_epu32(
            product, _mm256_loadu_si256((const __m256i *)raw_coefficients));
        __m256i raw = _mm256_and_si256(
            _mm256_add_epi64(_mm256_loadu_si256((const __m256i *)old), product),
            mask);
        if (signed_cells && bits != 0U)
            raw = _mm256_sub_epi64(_mm256_xor_si256(raw, sign), sign);
        _mm256_storeu_si256((__m256i *)old, raw);
        for (size_t lane = 0; lane < 4; ++lane)
            tape[bf_wrap_ptr(ptr, offsets[i + lane], len)] = old[lane];
        bf_native_avx2_lanes += 4;
        bf_kernel_batches++;
        bf_count_family(BF_KERNEL_FAMILY_SUMMARY, 4, 1);
        bf_count_native_family(BF_KERNEL_FAMILY_SUMMARY, 4);
    }
    if (i != count)
        bf_summary_scalar(tape, ptr, &offsets[i], &lhs[i], &rhs[i],
                          &coefficients[i], count - i, len, bits, signed_cells);
}

__attribute__((target("avx2")))
static size_t bf_first_empty_avx2(const uint8_t *controls, size_t count) {
    size_t i = 0;
    const __m256i zero = _mm256_setzero_si256();
    for (; i + 16 <= count; i += 16) {
        uint8_t lanes[32];
        memcpy(lanes, &controls[i], 16);
        memset(&lanes[16], 1, 16);
        unsigned mask = (unsigned)_mm256_movemask_epi8(_mm256_cmpeq_epi8(
            _mm256_loadu_si256((const __m256i *)lanes), zero));
        bf_native_avx2_lanes += 16;
        bf_kernel_batches++;
        bf_probe_kernel_lanes += 16;
        bf_native_probe_kernel_lanes += 16;
        bf_probe_kernel_batches++;
        if (mask != 0U)
            return i + (size_t)__builtin_ctz(mask);
    }
    return i + bf_first_empty_scalar(&controls[i], count - i);
}
#endif

#if BF_HAS_NEON_KERNEL && !defined(BF_FORCE_SCALAR_KERNEL)
static void bf_apply_deltas_neon(int64_t *tape, ptrdiff_t ptr,
                                 const ptrdiff_t *offsets,
                                 const int64_t *deltas, size_t count,
                                 ptrdiff_t len, unsigned bits,
                                 int signed_cells, unsigned family) {
    size_t i = 0;
    const uint64x2_t mask = vdupq_n_u64(bf_bits_mask(bits));
    const uint64x2_t sign = vdupq_n_u64(bits == 0 ? 0 :
                                       UINT64_C(1) << (bits - 1U));
    for (; i + 2 <= count; i += 2) {
        int64_t old[2] = {
            tape[bf_wrap_ptr(ptr, offsets[i], len)],
            tape[bf_wrap_ptr(ptr, offsets[i + 1], len)]};
        uint64x2_t raw = vandq_u64(
            vreinterpretq_u64_s64(vaddq_s64(vld1q_s64(old), vld1q_s64(&deltas[i]))),
            mask);
        if (signed_cells && bits != 0U)
            raw = vsubq_u64(veorq_u64(raw, sign), sign);
        vst1q_s64(old, vreinterpretq_s64_u64(raw));
        tape[bf_wrap_ptr(ptr, offsets[i], len)] = old[0];
        tape[bf_wrap_ptr(ptr, offsets[i + 1], len)] = old[1];
        bf_native_neon_lanes += 2;
        bf_kernel_batches++;
        bf_count_family(family, 2, 1);
        bf_count_native_family(family, 2);
    }
    if (i != count)
        bf_apply_deltas_scalar(tape, ptr, &offsets[i], &deltas[i], count - i,
                               len, bits, signed_cells, family);
}

static void bf_set_cells_neon(int64_t *tape, ptrdiff_t ptr,
                              const ptrdiff_t *offsets,
                              const int64_t *values, size_t count,
                              ptrdiff_t len) {
    size_t i = 0;
    for (; i + 2 <= count; i += 2) {
        ptrdiff_t dst = bf_wrap_ptr(ptr, offsets[i], len);
        vst1q_s64(&tape[dst], vld1q_s64(&values[i]));
        bf_native_neon_lanes += 2;
        bf_kernel_batches++;
        bf_clear_set_kernel_lanes += 2;
        bf_clear_set_kernel_batches++;
        bf_native_clear_set_kernel_lanes += 2;
    }
    if (i != count)
        bf_set_cells_scalar(tape, ptr, &offsets[i], &values[i], count - i, len);
}

static void bf_transfer_neon(int64_t *tape, ptrdiff_t ptr, int64_t source,
                             const ptrdiff_t *offsets,
                             const int64_t *coefficients, size_t count,
                             ptrdiff_t len, unsigned bits,
                             int signed_cells) {
    if (bits > 32U) {
        bf_transfer_scalar(tape, ptr, source, offsets, coefficients, count, len,
                           bits, signed_cells);
        return;
    }
    size_t i = 0;
    const uint32x2_t source_lanes =
        vdup_n_u32((uint32_t)bf_wrap_to_u64(source, bits));
    const uint64x2_t mask = vdupq_n_u64(bf_bits_mask(bits));
    const uint64x2_t sign =
        vdupq_n_u64(bits == 0 ? 0 : UINT64_C(1) << (bits - 1U));
    for (; i + 2 <= count; i += 2) {
        int64_t old[2] = {tape[bf_wrap_ptr(ptr, offsets[i], len)],
                          tape[bf_wrap_ptr(ptr, offsets[i + 1], len)]};
        uint32_t raw_coefficients[2] = {
            (uint32_t)bf_wrap_to_u64(coefficients[i], bits),
            (uint32_t)bf_wrap_to_u64(coefficients[i + 1], bits)};
        uint64x2_t raw = vandq_u64(
            vaddq_u64(vreinterpretq_u64_s64(vld1q_s64(old)),
                      vmull_u32(source_lanes, vld1_u32(raw_coefficients))),
            mask);
        if (signed_cells && bits != 0U)
            raw = vsubq_u64(veorq_u64(raw, sign), sign);
        vst1q_s64(old, vreinterpretq_s64_u64(raw));
        tape[bf_wrap_ptr(ptr, offsets[i], len)] = old[0];
        tape[bf_wrap_ptr(ptr, offsets[i + 1], len)] = old[1];
        bf_native_neon_lanes += 2;
        bf_kernel_batches++;
        bf_count_family(BF_KERNEL_FAMILY_TRANSFER, 2, 1);
        bf_count_native_family(BF_KERNEL_FAMILY_TRANSFER, 2);
    }
    if (i != count)
        bf_transfer_scalar(tape, ptr, source, &offsets[i], &coefficients[i],
                           count - i, len, bits, signed_cells);
}

static void bf_summary_neon(int64_t *tape, ptrdiff_t ptr,
                            const ptrdiff_t *offsets, const int64_t *lhs,
                            const int64_t *rhs, const int64_t *coefficients,
                            size_t count, ptrdiff_t len, unsigned bits,
                            int signed_cells) {
    if (bits > 32U) {
        bf_summary_scalar(tape, ptr, offsets, lhs, rhs, coefficients, count, len,
                          bits, signed_cells);
        return;
    }
    size_t i = 0;
    const uint64x2_t mask = vdupq_n_u64(bf_bits_mask(bits));
    const uint64x2_t sign =
        vdupq_n_u64(bits == 0 ? 0 : UINT64_C(1) << (bits - 1U));
    for (; i + 2 <= count; i += 2) {
        int64_t old[2] = {tape[bf_wrap_ptr(ptr, offsets[i], len)],
                          tape[bf_wrap_ptr(ptr, offsets[i + 1], len)]};
        uint32_t raw_lhs[2] = {(uint32_t)bf_wrap_to_u64(lhs[i], bits),
                               (uint32_t)bf_wrap_to_u64(lhs[i + 1], bits)};
        uint32_t raw_rhs[2] = {(uint32_t)bf_wrap_to_u64(rhs[i], bits),
                               (uint32_t)bf_wrap_to_u64(rhs[i + 1], bits)};
        uint32_t raw_coefficients[2] = {
            (uint32_t)bf_wrap_to_u64(coefficients[i], bits),
            (uint32_t)bf_wrap_to_u64(coefficients[i + 1], bits)};
        uint64x2_t product = vmull_u32(vld1_u32(raw_lhs), vld1_u32(raw_rhs));
        product = vmull_u32(vmovn_u64(product), vld1_u32(raw_coefficients));
        uint64x2_t raw = vandq_u64(
            vaddq_u64(vreinterpretq_u64_s64(vld1q_s64(old)), product), mask);
        if (signed_cells && bits != 0U)
            raw = vsubq_u64(veorq_u64(raw, sign), sign);
        vst1q_s64(old, vreinterpretq_s64_u64(raw));
        tape[bf_wrap_ptr(ptr, offsets[i], len)] = old[0];
        tape[bf_wrap_ptr(ptr, offsets[i + 1], len)] = old[1];
        bf_native_neon_lanes += 2;
        bf_kernel_batches++;
        bf_count_family(BF_KERNEL_FAMILY_SUMMARY, 2, 1);
        bf_count_native_family(BF_KERNEL_FAMILY_SUMMARY, 2);
    }
    if (i != count)
        bf_summary_scalar(tape, ptr, &offsets[i], &lhs[i], &rhs[i],
                          &coefficients[i], count - i, len, bits, signed_cells);
}

static size_t bf_first_empty_neon(const uint8_t *controls, size_t count) {
    size_t i = 0;
    const uint8x16_t zero = vdupq_n_u8(0);
    for (; i + 16 <= count; i += 16) {
        uint8_t matches[16];
        vst1q_u8(matches, vceqq_u8(vld1q_u8(&controls[i]), zero));
        bf_native_neon_lanes += 16;
        bf_kernel_batches++;
        bf_probe_kernel_lanes += 16;
        bf_native_probe_kernel_lanes += 16;
        bf_probe_kernel_batches++;
        for (size_t lane = 0; lane < 16; ++lane) {
            if (matches[lane] != 0)
                return i + lane;
        }
    }
    return i + bf_first_empty_scalar(&controls[i], count - i);
}
#endif

static ptrdiff_t bf_scan_zero_scalar(const int64_t *tape, ptrdiff_t ptr,
                                     ptrdiff_t stride, ptrdiff_t len,
                                     uint64_t *steps) {
    bf_scan_kernel_batches++;
    while (1) {
        bf_scan_kernel_lanes++;
        bf_scalar_kernel_lanes++;
        bf_scalar_scan_kernel_lanes++;
        if (tape[ptr] == 0)
            return ptr;
        (*steps)++;
        bf_work_scan_steps(UINT64_C(1));
        ptr = bf_wrap_ptr(ptr, stride, len);
    }
}

#if BF_HAS_AVX2_KERNEL && !defined(BF_FORCE_SCALAR_KERNEL)
__attribute__((target("avx2")))
static ptrdiff_t bf_scan_zero_avx2(const int64_t *tape, ptrdiff_t ptr,
                                  ptrdiff_t stride, ptrdiff_t len,
                                  uint64_t *steps) {
    const __m256i zero = _mm256_setzero_si256();
    while ((stride == 1 && ptr <= len - 4) || (stride == -1 && ptr >= 3)) {
        ptrdiff_t start = stride == 1 ? ptr : ptr - 3;
        __m256i cells = _mm256_loadu_si256((const __m256i *)&tape[start]);
        unsigned mask = (unsigned)_mm256_movemask_epi8(_mm256_cmpeq_epi64(cells, zero));
        bf_native_avx2_lanes += 4;
        bf_native_scan_kernel_lanes += 4;
        bf_scan_kernel_lanes += 4;
        bf_scan_kernel_batches++;
        bf_kernel_batches++;
        if (mask != 0U) {
            if (stride == 1) {
                for (ptrdiff_t lane = 0; lane < 4; ++lane) {
                    if ((mask & (UINT32_C(255) << (unsigned)(lane * 8))) != 0U) {
                        *steps += (uint64_t)lane;
                        bf_work_scan_steps((uint64_t)lane);
                        return ptr + lane;
                    }
                }
            } else {
                for (ptrdiff_t lane = 3; lane >= 0; --lane) {
                    if ((mask & (UINT32_C(255) << (unsigned)(lane * 8))) != 0U) {
                        *steps += (uint64_t)(3 - lane);
                        bf_work_scan_steps((uint64_t)(3 - lane));
                        return start + lane;
                    }
                }
            }
        }
        *steps += 4;
        bf_work_scan_steps(UINT64_C(4));
        ptr += stride * 4;
    }
    return bf_scan_zero_scalar(tape, bf_wrap_ptr(ptr, 0, len), stride, len, steps);
}
#endif

#if BF_HAS_NEON_KERNEL && !defined(BF_FORCE_SCALAR_KERNEL)
static ptrdiff_t bf_scan_zero_neon(const int64_t *tape, ptrdiff_t ptr,
                                  ptrdiff_t stride, ptrdiff_t len,
                                  uint64_t *steps) {
    const int64x2_t zero = vdupq_n_s64(0);
    while ((stride == 1 && ptr <= len - 2) || (stride == -1 && ptr >= 1)) {
        ptrdiff_t start = stride == 1 ? ptr : ptr - 1;
        uint64_t matches[2];
        vst1q_u64(matches, vceqq_s64(vld1q_s64(&tape[start]), zero));
        bf_native_neon_lanes += 2;
        bf_native_scan_kernel_lanes += 2;
        bf_scan_kernel_lanes += 2;
        bf_scan_kernel_batches++;
        bf_kernel_batches++;
        if (stride == 1) {
            if (matches[0] != 0) return ptr;
            if (matches[1] != 0) { (*steps)++; bf_work_scan_steps(UINT64_C(1)); return ptr + 1; }
        } else {
            if (matches[1] != 0) return ptr;
            if (matches[0] != 0) { (*steps)++; bf_work_scan_steps(UINT64_C(1)); return ptr - 1; }
        }
        *steps += 2;
        bf_work_scan_steps(UINT64_C(2));
        ptr += stride * 2;
    }
    return bf_scan_zero_scalar(tape, bf_wrap_ptr(ptr, 0, len), stride, len, steps);
}
#endif

static BfKernelSet bf_kernels = {bf_scan_zero_scalar, bf_apply_deltas_scalar,
                                 bf_set_cells_scalar, bf_transfer_scalar,
                                 bf_summary_scalar, bf_first_empty_scalar};

static void bf_kernel_init(void) {
#if defined(BF_FORCE_SCALAR_KERNEL)
    return;
#else
#if BF_HAS_AVX2_KERNEL
    __builtin_cpu_init();
    if (__builtin_cpu_supports("avx2")) {
        bf_kernels.scan_zero = bf_scan_zero_avx2;
        bf_kernels.apply_deltas = bf_apply_deltas_avx2;
        bf_kernels.set_cells = bf_set_cells_avx2;
        bf_kernels.transfer = bf_transfer_avx2;
        bf_kernels.summary = bf_summary_avx2;
        bf_kernels.first_empty = bf_first_empty_avx2;
        return;
    }
#endif
#if BF_HAS_NEON_KERNEL
    bf_kernels.scan_zero = bf_scan_zero_neon;
    bf_kernels.apply_deltas = bf_apply_deltas_neon;
    bf_kernels.set_cells = bf_set_cells_neon;
    bf_kernels.transfer = bf_transfer_neon;
    bf_kernels.summary = bf_summary_neon;
    bf_kernels.first_empty = bf_first_empty_neon;
#endif
#endif
}

ptrdiff_t bf_scan_zero(const int64_t *tape, ptrdiff_t ptr,
                       ptrdiff_t stride, ptrdiff_t len, uint64_t *steps) {
    return bf_kernels.scan_zero(tape, ptr, stride, len, steps);
}

void bf_add_at_batch(int64_t *tape, ptrdiff_t ptr,
                     const ptrdiff_t *offsets, const int64_t *deltas,
                     size_t count, ptrdiff_t len, unsigned bits,
                     int signed_cells) {
    if (!bf_offsets_are_disjoint(ptr, offsets, count, len, -1)) {
        bf_apply_deltas_scalar(tape, ptr, offsets, deltas, count, len, bits,
                               signed_cells, BF_KERNEL_FAMILY_ADD);
        return;
    }
    bf_kernels.apply_deltas(tape, ptr, offsets, deltas, count, len, bits,
                            signed_cells, BF_KERNEL_FAMILY_ADD);
}

void bf_clear_set_batch(int64_t *tape, ptrdiff_t ptr,
                        const ptrdiff_t *offsets, const int64_t *values,
                        size_t count, ptrdiff_t len) {
    if (!bf_offsets_are_disjoint(ptr, offsets, count, len, -1) ||
        !bf_offsets_are_contiguous(ptr, offsets, count, len)) {
        bf_set_cells_scalar(tape, ptr, offsets, values, count, len);
        return;
    }
    bf_kernels.set_cells(tape, ptr, offsets, values, count, len);
}

void bf_transfer_batch(int64_t *tape, ptrdiff_t ptr, ptrdiff_t source_offset,
                       const ptrdiff_t *offsets, const int64_t *coefficients,
                       size_t count, int preserve_source, ptrdiff_t len,
                       unsigned bits, int signed_cells) {
    ptrdiff_t source_ptr = bf_wrap_ptr(ptr, source_offset, len);
    int64_t source = tape[source_ptr];
    if (!bf_offsets_are_disjoint(ptr, offsets, count, len, source_ptr)) {
        bf_transfer_scalar(tape, ptr, source, offsets, coefficients, count, len,
                           bits, signed_cells);
    } else {
        bf_kernels.transfer(tape, ptr, source, offsets, coefficients, count, len,
                            bits, signed_cells);
    }
    if (!preserve_source)
        tape[source_ptr] = 0;
}

static void bf_summary_product_batch(int64_t *tape, ptrdiff_t ptr,
                                     const ptrdiff_t *offsets,
                                     const int64_t *lhs, const int64_t *rhs,
                                     const int64_t *coefficients,
                                     size_t count) {
    if (!bf_offsets_are_disjoint(ptr, offsets, count, BF_TAPE_LEN, -1)) {
        bf_summary_scalar(tape, ptr, offsets, lhs, rhs, coefficients, count,
                          BF_TAPE_LEN, BF_CELL_BITS, BF_SIGNED_CELLS);
        return;
    }
    bf_kernels.summary(tape, ptr, offsets, lhs, rhs, coefficients, count,
                       BF_TAPE_LEN, BF_CELL_BITS, BF_SIGNED_CELLS);
}

int bf_trace_dynamic_loop(const DynamicLoopSpec *spec) {
    if (spec->node_id >= MAX_NODES) {
        return 0;
    }
    RuntimeLoopSummary *summary = &runtime_loop_summaries[spec->node_id];
    dynamic_trace_attempts++;
    ptrdiff_t pointer = 0;
    ptrdiff_t min_offset = 0;
    ptrdiff_t max_offset = 0;
    for (uint16_t i = 0; i < spec->op_count; ++i) {
        const DynamicOp *op = &spec->ops[i];
        if (op->kind == BF_DYNAMIC_OP_MOVE) {
            pointer += op->a;
            if (pointer < min_offset)
                min_offset = pointer;
            if (pointer > max_offset)
                max_offset = pointer;
        } else if (op->kind == BF_DYNAMIC_OP_AFFINE) {
            ptrdiff_t src = pointer + op->a;
            ptrdiff_t dst = pointer + op->b;
            if (src < min_offset)
                min_offset = src;
            if (src > max_offset)
                max_offset = src;
            if (dst < min_offset)
                min_offset = dst;
            if (dst > max_offset)
                max_offset = dst;
            if (op->flags != 1U || src == 0 || dst == 0) {
                summary->state = BF_DYNAMIC_UNSUPPORTED;
                dynamic_trace_rejections++;
                return 0;
            }
        } else if (op->kind != BF_DYNAMIC_OP_ADD) {
            summary->state = BF_DYNAMIC_UNSUPPORTED;
            dynamic_trace_rejections++;
            return 0;
        }
    }
    ptrdiff_t span = max_offset - min_offset + 1;
    if (pointer != 0 || span <= 0 || span > BF_MEMO_WINDOW_MAX) {
        summary->state = BF_DYNAMIC_UNSUPPORTED;
        dynamic_trace_rejections++;
        return 0;
    }
    int64_t deltas[BF_INLINE_MEMO_WINDOW] = {0};
    uint8_t written[BF_INLINE_MEMO_WINDOW] = {0};
    pointer = 0;
    for (uint16_t i = 0; i < spec->op_count; ++i) {
        const DynamicOp *op = &spec->ops[i];
        if (op->kind == BF_DYNAMIC_OP_MOVE) {
            pointer += op->a;
        } else if (op->kind == BF_DYNAMIC_OP_ADD) {
            deltas[pointer - min_offset] += op->a;
            written[pointer - min_offset] = 1;
        } else if (op->kind == BF_DYNAMIC_OP_AFFINE) {
            written[pointer + op->b - min_offset] = 1;
        }
    }
    int64_t guard_delta = deltas[-min_offset];
    if (guard_delta != -1 && guard_delta != 1) {
        summary->state = BF_DYNAMIC_UNSUPPORTED;
        dynamic_trace_rejections++;
        return 0;
    }
    uint8_t effect_count = 0;
    for (ptrdiff_t offset = min_offset; offset <= max_offset; ++offset) {
        if (offset == 0)
            continue;
        int64_t delta = deltas[offset - min_offset];
        if (delta == 0)
            continue;
        if (effect_count >= BF_RUNTIME_SUMMARY_EFFECT_MAX - 1U ||
            delta > INT32_MAX || delta < INT32_MIN ||
            (guard_delta == 1 && delta == INT32_MIN)) {
            summary->state = BF_DYNAMIC_UNSUPPORTED;
            dynamic_trace_rejections++;
            return 0;
        }
        summary->effects[effect_count++] = (RuntimeSummaryEffect){
            .kind = BF_SUMMARY_EFFECT_ADD_SCALED,
            .dst_offset = (int32_t)offset,
            .src_offset = 0,
            .coeff = (int32_t)(guard_delta == -1 ? delta : -delta)};
    }
    pointer = 0;
    for (uint16_t i = 0; i < spec->op_count; ++i) {
        const DynamicOp *op = &spec->ops[i];
        if (op->kind == BF_DYNAMIC_OP_MOVE) {
            pointer += op->a;
            continue;
        }
        if (op->kind != BF_DYNAMIC_OP_AFFINE)
            continue;
        ptrdiff_t src = pointer + op->a;
        ptrdiff_t dst = pointer + op->b;
        if (written[src - min_offset] ||
            effect_count >= BF_RUNTIME_SUMMARY_EFFECT_MAX - 1U ||
            (guard_delta == 1 && op->c == INT32_MIN)) {
            summary->state = BF_DYNAMIC_UNSUPPORTED;
            dynamic_trace_rejections++;
            return 0;
        }
        summary->effects[effect_count++] =
            (RuntimeSummaryEffect){.kind = BF_SUMMARY_EFFECT_ADD_PRODUCT,
                                   .dst_offset = (int32_t)dst,
                                   .src_offset = (int32_t)src,
                                   .coeff = guard_delta == -1 ? op->c : -op->c};
    }
    summary->effects[effect_count++] =
        (RuntimeSummaryEffect){.kind = BF_SUMMARY_EFFECT_CLEAR,
                               .dst_offset = 0,
                               .src_offset = 0,
                               .coeff = 0};
    summary->effect_count = effect_count;
    summary->guard_delta = (int8_t)guard_delta;
    summary->body_hash = spec->body_hash;
    summary->state = BF_DYNAMIC_INSTALLED;
    dynamic_trace_successes++;
    return 1;
}

int bf_apply_runtime_summary(const DynamicLoopSpec *spec,
                             int64_t tape[BF_TAPE_LEN], ptrdiff_t ptr) {
    if (spec->node_id >= MAX_NODES)
        return 0;
    RuntimeLoopSummary *summary = &runtime_loop_summaries[spec->node_id];
    if (summary->state != BF_DYNAMIC_INSTALLED)
        return 0;
    if (summary->body_hash != spec->body_hash) {
        dynamic_summary_guard_failures++;
        return 0;
    }
    if (summary->guard_delta != -1 && summary->guard_delta != 1) {
        dynamic_summary_guard_failures++;
        return 0;
    }
    int64_t source = tape[ptr];
    ptrdiff_t delta_offsets[BF_RUNTIME_SUMMARY_EFFECT_MAX];
    int64_t lhs_values[BF_RUNTIME_SUMMARY_EFFECT_MAX];
    int64_t rhs_values[BF_RUNTIME_SUMMARY_EFFECT_MAX];
    int64_t coefficients[BF_RUNTIME_SUMMARY_EFFECT_MAX];
    ptrdiff_t clear_offsets[BF_RUNTIME_SUMMARY_EFFECT_MAX];
    int64_t clear_values[BF_RUNTIME_SUMMARY_EFFECT_MAX] = {0};
    size_t delta_count = 0;
    size_t clear_count = 0;
    for (uint8_t i = 0; i < summary->effect_count; ++i) {
        RuntimeSummaryEffect *effect = &summary->effects[i];
        if (effect->kind == BF_SUMMARY_EFFECT_CLEAR) {
            clear_offsets[clear_count++] = effect->dst_offset;
        } else if (effect->kind == BF_SUMMARY_EFFECT_ADD_SCALED) {
            delta_offsets[delta_count] = effect->dst_offset;
            lhs_values[delta_count] = source;
            rhs_values[delta_count] = 1;
            coefficients[delta_count++] = effect->coeff;
        } else if (effect->kind == BF_SUMMARY_EFFECT_ADD_PRODUCT) {
            ptrdiff_t rhs_ptr = bf_wrap_ptr(ptr, effect->src_offset, BF_TAPE_LEN);
            delta_offsets[delta_count] = effect->dst_offset;
            lhs_values[delta_count] = source;
            rhs_values[delta_count] = tape[rhs_ptr];
            coefficients[delta_count++] = effect->coeff;
        } else {
            dynamic_summary_guard_failures++;
            return 0;
        }
    }
    bf_summary_product_batch(tape, ptr, delta_offsets, lhs_values, rhs_values,
                             coefficients, delta_count);
    bf_clear_set_batch(tape, ptr, clear_offsets, clear_values, clear_count,
                       BF_TAPE_LEN);
    dynamic_summary_hits++;
    return 1;
}

void bf_capture_dynamic_window(const DynamicLoopSpec *spec,
                               const int64_t tape[BF_TAPE_LEN], ptrdiff_t ptr,
                               int64_t values[BF_INLINE_MEMO_WINDOW]) {
    for (uint8_t i = 0; i < spec->window_len; ++i) {
        ptrdiff_t offset = (ptrdiff_t)spec->window_start + (ptrdiff_t)i;
        values[i] = tape[bf_wrap_ptr(ptr, offset, BF_TAPE_LEN)];
    }
}

int bf_try_runtime_transducer(const DynamicLoopSpec *spec,
                              int64_t tape[BF_TAPE_LEN], ptrdiff_t ptr) {
    int64_t input[BF_INLINE_MEMO_WINDOW] = {0};
    bf_capture_dynamic_window(spec, tape, ptr, input);
    uint8_t occupied = 0;
    for (uint8_t slot = 0; slot < BF_TRANSDUCER_CAPACITY; ++slot) {
        RuntimeTransducerEntry *entry = &runtime_transducers[spec->node_id][slot];
        if (!entry->occupied)
            continue;
        occupied++;
        if (entry->body_hash != spec->body_hash) {
            dynamic_transducer_guard_failures++;
            continue;
        }
        if (memcmp(entry->input, input, spec->window_len * sizeof(input[0])) != 0)
            continue;
        for (uint8_t i = 0; i < spec->window_len; ++i) {
            ptrdiff_t offset = (ptrdiff_t)spec->window_start + (ptrdiff_t)i;
            tape[bf_wrap_ptr(ptr, offset, BF_TAPE_LEN)] = entry->output[i];
        }
        dynamic_transducer_hits++;
        return 1;
    }
    dynamic_transducer_guard_failures++;
    return occupied < BF_TRANSDUCER_CAPACITY ? 0 : -1;
}

void bf_record_runtime_transducer(const DynamicLoopSpec *spec,
                                  const int64_t input[BF_INLINE_MEMO_WINDOW],
                                  const int64_t tape[BF_TAPE_LEN],
                                  ptrdiff_t ptr) {
    for (uint8_t slot = 0; slot < BF_TRANSDUCER_CAPACITY; ++slot) {
        RuntimeTransducerEntry *entry = &runtime_transducers[spec->node_id][slot];
        if (entry->occupied)
            continue;
        entry->occupied = 1;
        entry->body_hash = spec->body_hash;
        memcpy(entry->input, input, spec->window_len * sizeof(input[0]));
        bf_capture_dynamic_window(spec, tape, ptr, entry->output);
        dynamic_transducer_installs++;
        return;
    }
}

int bf_dynamic_loop_try_summary(const DynamicLoopSpec *spec,
                                int64_t tape[BF_TAPE_LEN], ptrdiff_t ptr) {
    if (spec->node_id >= MAX_NODES)
        return -1;
    RuntimeLoopSummary *summary = &runtime_loop_summaries[spec->node_id];
    if (summary->state == BF_DYNAMIC_INSTALLED) {
        return bf_apply_runtime_summary(spec, tape, ptr) ? 1 : 0;
    }
    if (summary->state == BF_DYNAMIC_UNSUPPORTED) {
        int transducer = bf_try_runtime_transducer(spec, tape, ptr);
        return transducer == 1 ? 1 : (transducer == 0 ? -2 : -1);
    }
    dynamic_loop_entries[spec->node_id]++;
    if (dynamic_loop_entries[spec->node_id] >= BF_DYNAMIC_HOT_THRESHOLD) {
        if (bf_trace_dynamic_loop(spec) &&
            bf_apply_runtime_summary(spec, tape, ptr))
            return 1;
        if (summary->state == BF_DYNAMIC_UNSUPPORTED) {
            int transducer = bf_try_runtime_transducer(spec, tape, ptr);
            return transducer == 1 ? 1 : (transducer == 0 ? -2 : -1);
        }
    }
    return 0;
}

uint64_t bf_hash_memo_key(const MemoKey *key) {
    uint64_t hash = UINT64_C(1469598103934665603) ^ key->node_id;
    hash ^= (uint32_t)key->window_start;
    hash *= UINT64_C(1099511628211);
    hash ^= key->window_len;
    hash *= UINT64_C(1099511628211);
    for (uint8_t i = 0; i < key->window_len; ++i) {
        hash ^= bf_wrap_to_u64(key->window[i], BF_CELL_BITS);
        hash *= UINT64_C(1099511628211);
    }
    return hash;
}

int bf_same_memo_key(const MemoKey *lhs_key, const MemoKey *rhs_key) {
    return lhs_key->node_id == rhs_key->node_id &&
           lhs_key->window_start == rhs_key->window_start &&
           lhs_key->window_len == rhs_key->window_len &&
           memcmp(lhs_key->window, rhs_key->window, sizeof(lhs_key->window)) == 0;
}

uint64_t bf_next_memo_stamp(void) {
    if (memo_epoch == UINT64_MAX) {
        for (size_t i = 0; i < BF_MEMO_CAPACITY; ++i) {
            if (bf_memo[i].occupied) {
                bf_memo[i].stamp = (bf_memo[i].stamp >> 1) | UINT64_C(1);
            }
        }
        memo_epoch = UINT64_C(1) << 62U;
    }
    memo_epoch++;
    return memo_epoch;
}

size_t bf_memo_probe_limit(void) {
    return BF_MEMO_CAPACITY < BF_MEMO_PROBE_LIMIT ? BF_MEMO_CAPACITY
                                                  : BF_MEMO_PROBE_LIMIT;
}

int bf_memo_lookup(const MemoKey *key, MemoVal *out) {
    uint64_t hash = bf_hash_memo_key(key);
    size_t probe_limit = bf_memo_probe_limit();
    uint8_t controls[BF_MEMO_PROBE_LIMIT];
    for (size_t probe = 0; probe < probe_limit; ++probe) {
        size_t slot = (size_t)((hash + probe) % BF_MEMO_CAPACITY);
        controls[probe] = bf_memo[slot].occupied;
    }
    size_t first_empty = bf_kernels.first_empty(controls, probe_limit);
    size_t scan_limit = first_empty < probe_limit ? first_empty + 1 : probe_limit;
    for (size_t probe = 0; probe < scan_limit; ++probe) {
        size_t slot = (size_t)((hash + probe) % BF_MEMO_CAPACITY);
        if (!bf_memo[slot].occupied) {
            memo_misses++;
            if (probe + 1 > memo_lookup_max_probe) {
                memo_lookup_max_probe = probe + 1;
            }
            if (key->node_id < MAX_NODES) {
                node_misses[key->node_id]++;
            }
            return 0;
        }
        if (bf_same_memo_key(&bf_memo[slot].key, key)) {
            memo_hits++;
            bf_memo[slot].stamp = bf_next_memo_stamp();
            if (probe + 1 > memo_lookup_max_probe) {
                memo_lookup_max_probe = probe + 1;
            }
            if (key->node_id < MAX_NODES) {
                node_hits[key->node_id]++;
            }
            *out = bf_memo[slot].value;
            return 1;
        }
    }
    memo_misses++;
    if (probe_limit > memo_lookup_max_probe) {
        memo_lookup_max_probe = probe_limit;
    }
    if (key->node_id < MAX_NODES) {
        node_misses[key->node_id]++;
    }
    return 0;
}

void bf_memo_store(const MemoKey *key, const MemoVal *value) {
    uint64_t hash = bf_hash_memo_key(key);
    size_t probe_limit = bf_memo_probe_limit();
    uint8_t controls[BF_MEMO_PROBE_LIMIT];
    for (size_t probe = 0; probe < probe_limit; ++probe) {
        size_t slot = (size_t)((hash + probe) % BF_MEMO_CAPACITY);
        controls[probe] = bf_memo[slot].occupied;
    }
    size_t first_empty = bf_kernels.first_empty(controls, probe_limit);
    size_t scan_limit = first_empty < probe_limit ? first_empty + 1 : probe_limit;
    size_t oldest_slot = 0;
    uint64_t oldest_stamp = UINT64_MAX;
    for (size_t probe = 0; probe < scan_limit; ++probe) {
        size_t slot = (size_t)((hash + probe) % BF_MEMO_CAPACITY);
        if (bf_memo[slot].occupied && bf_memo[slot].stamp <= oldest_stamp) {
            oldest_stamp = bf_memo[slot].stamp;
            oldest_slot = slot;
        }
        if (!bf_memo[slot].occupied || bf_same_memo_key(&bf_memo[slot].key, key)) {
            bf_memo[slot].occupied = 1;
            bf_memo[slot].stamp = bf_next_memo_stamp();
            bf_memo[slot].key = *key;
            bf_memo[slot].value = *value;
            if (probe + 1 > memo_store_max_probe) {
                memo_store_max_probe = probe + 1;
            }
            return;
        }
    }
    bf_memo[oldest_slot].occupied = 1;
    bf_memo[oldest_slot].stamp = bf_next_memo_stamp();
    bf_memo[oldest_slot].key = *key;
    bf_memo[oldest_slot].value = *value;
    memo_evictions++;
    if (probe_limit > memo_store_max_probe) {
        memo_store_max_probe = probe_limit;
    }
}

static void print_memo_stats(void) {
    printf("\n=== BF SUPER RUNTIME STATS ===\n");
    printf("work dispatches: %llu\n", (unsigned long long)bf_work_dispatches);
    printf("work loop iterations: %llu\n",
           (unsigned long long)bf_work_loop_iterations);
    printf("work ops: %llu\n", (unsigned long long)bf_work_ops);
    printf("semantic steps: %llu\n", (unsigned long long)bf_semantic_steps);
    printf("bf native avx2 lanes: %llu\n",
           (unsigned long long)bf_native_avx2_lanes);
    printf("bf native neon lanes: %llu\n",
           (unsigned long long)bf_native_neon_lanes);
    printf("bf scalar kernel lanes: %llu\n",
           (unsigned long long)bf_scalar_kernel_lanes);
    printf("bf kernel batches: %llu\n", (unsigned long long)bf_kernel_batches);
    printf("bf scan kernel lanes: %llu\n", (unsigned long long)bf_scan_kernel_lanes);
    printf("bf scan kernel batches: %llu\n",
           (unsigned long long)bf_scan_kernel_batches);
    printf("bf add kernel lanes: %llu\n", (unsigned long long)bf_add_kernel_lanes);
    printf("bf add kernel batches: %llu\n", (unsigned long long)bf_add_kernel_batches);
    printf("bf clear/set kernel lanes: %llu\n",
           (unsigned long long)bf_clear_set_kernel_lanes);
    printf("bf clear/set kernel batches: %llu\n",
           (unsigned long long)bf_clear_set_kernel_batches);
    printf("bf transfer kernel lanes: %llu\n",
           (unsigned long long)bf_transfer_kernel_lanes);
    printf("bf transfer kernel batches: %llu\n",
           (unsigned long long)bf_transfer_kernel_batches);
    printf("bf summary kernel lanes: %llu\n",
           (unsigned long long)bf_summary_kernel_lanes);
    printf("bf summary kernel batches: %llu\n",
           (unsigned long long)bf_summary_kernel_batches);
    printf("bf probe kernel lanes: %llu\n", (unsigned long long)bf_probe_kernel_lanes);
    printf("bf probe kernel batches: %llu\n",
           (unsigned long long)bf_probe_kernel_batches);
    printf("bf native scan kernel lanes: %llu\n",
           (unsigned long long)bf_native_scan_kernel_lanes);
    printf("bf native add kernel lanes: %llu\n",
           (unsigned long long)bf_native_add_kernel_lanes);
    printf("bf native clear/set kernel lanes: %llu\n",
           (unsigned long long)bf_native_clear_set_kernel_lanes);
    printf("bf native transfer kernel lanes: %llu\n",
           (unsigned long long)bf_native_transfer_kernel_lanes);
    printf("bf native summary kernel lanes: %llu\n",
           (unsigned long long)bf_native_summary_kernel_lanes);
    printf("bf native probe kernel lanes: %llu\n",
           (unsigned long long)bf_native_probe_kernel_lanes);
    printf("bf scalar scan kernel lanes: %llu\n",
           (unsigned long long)bf_scalar_scan_kernel_lanes);
    printf("bf scalar add kernel lanes: %llu\n",
           (unsigned long long)bf_scalar_add_kernel_lanes);
    printf("bf scalar clear/set kernel lanes: %llu\n",
           (unsigned long long)bf_scalar_clear_set_kernel_lanes);
    printf("bf scalar transfer kernel lanes: %llu\n",
           (unsigned long long)bf_scalar_transfer_kernel_lanes);
    printf("bf scalar summary kernel lanes: %llu\n",
           (unsigned long long)bf_scalar_summary_kernel_lanes);
    printf("bf scalar probe kernel lanes: %llu\n",
           (unsigned long long)bf_scalar_probe_kernel_lanes);
    printf("memo hits:   %llu\n", (unsigned long long)memo_hits);
    printf("memo misses: %llu\n", (unsigned long long)memo_misses);
    printf("memo evictions: %llu\n", (unsigned long long)memo_evictions);
    printf("memo lookup max probe: %llu\n",
           (unsigned long long)memo_lookup_max_probe);
    printf("memo store max probe:  %llu\n",
           (unsigned long long)memo_store_max_probe);
    printf("symbolic power hits: %llu\n",
           (unsigned long long)symbolic_power_hits);
    printf("symbolic power builds: %llu\n",
           (unsigned long long)symbolic_power_builds);
    printf("recursion fallbacks: %llu\n",
           (unsigned long long)recursion_fallbacks);
    printf("max recursion depth: %llu\n",
           (unsigned long long)recursion_depth_max);
    printf("dynamic fallback entries: %llu\n",
           (unsigned long long)dynamic_fallback_entries);
    printf("dynamic fallback iterations: %llu\n",
           (unsigned long long)dynamic_fallback_iterations);
    printf("dynamic trace attempts: %llu\n",
           (unsigned long long)dynamic_trace_attempts);
    printf("dynamic trace successes: %llu\n",
           (unsigned long long)dynamic_trace_successes);
    printf("dynamic trace rejections: %llu\n",
           (unsigned long long)dynamic_trace_rejections);
    printf("dynamic summary hits: %llu\n",
           (unsigned long long)dynamic_summary_hits);
    printf("dynamic summary guard failures: %llu\n",
           (unsigned long long)dynamic_summary_guard_failures);
    printf("dynamic memo after rejection: %llu\n",
           (unsigned long long)dynamic_memo_after_rejection);
    printf("dynamic transducer installs: %llu\n",
           (unsigned long long)dynamic_transducer_installs);
    printf("dynamic transducer hits: %llu\n",
           (unsigned long long)dynamic_transducer_hits);
    printf("dynamic transducer guard failures: %llu\n",
           (unsigned long long)dynamic_transducer_guard_failures);
    printf("\nper-node stats:\n");
    for (int i = 0; i < MAX_NODES; ++i) {
        if (node_hits[i] || node_misses[i]) {
            printf("node %d: hits=%llu misses=%llu\n", i,
                   (unsigned long long)node_hits[i],
                   (unsigned long long)node_misses[i]);
        }
    }
}

/* @BF_FUNCTIONS */

#ifndef BF_TEMPLATE_HAS_FUNCTIONS
static void exec_node_0(int64_t tape[BF_TAPE_LEN], ptrdiff_t *ptr_ref) {
    (void)tape;
    (void)ptr_ref;
}
#endif

#define BF_EXEC_NODE_NAME2(id) exec_node_##id
#define BF_EXEC_NODE_NAME(id) BF_EXEC_NODE_NAME2(id)

int main(void) {
    int64_t tape[BF_TAPE_LEN] = {0};
    ptrdiff_t ptr = 0;
    bf_configure_binary_stdio();
    bf_kernel_init();
    BF_EXEC_NODE_NAME(BF_TEMPLATE_ROOT_NODE)(tape, &ptr);
    print_memo_stats();
    return 0;
}
