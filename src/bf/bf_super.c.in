typedef struct {
    uint32_t node_id;
    int32_t window_start;
    uint8_t window_len;
    int64_t window[BF_INLINE_MEMO_WINDOW];
} MemoKey;

typedef struct {
    uint32_t node_id;
    int32_t window_start;
    uint8_t window_len;
    ptrdiff_t ptr_delta;
    int64_t window[BF_INLINE_MEMO_WINDOW];
} MemoVal;

typedef struct {
    uint8_t occupied;
    uint64_t stamp;
    MemoKey key;
    MemoVal value;
} MemoSlot;

typedef struct {
    uint8_t kind;
    int32_t a;
    int32_t b;
    int32_t c;
    uint8_t flags;
} DynamicOp;

typedef struct {
    uint32_t node_id;
    uint64_t body_hash;
    int32_t window_start;
    uint8_t window_len;
    uint16_t op_count;
    const DynamicOp *ops;
} DynamicLoopSpec;

typedef struct {
    uint8_t kind;
    int32_t dst_offset;
    int32_t src_offset;
    int32_t coeff;
} RuntimeSummaryEffect;

typedef struct {
    uint8_t state;
    uint8_t effect_count;
    int8_t guard_delta;
    uint64_t body_hash;
    RuntimeSummaryEffect effects[BF_RUNTIME_SUMMARY_EFFECT_MAX];
} RuntimeLoopSummary;

typedef struct {
    uint8_t occupied;
    uint64_t body_hash;
    int64_t input[BF_INLINE_MEMO_WINDOW];
    int64_t output[BF_INLINE_MEMO_WINDOW];
} RuntimeTransducerEntry;

enum {
    BF_DYNAMIC_COLD = 0,
    BF_DYNAMIC_INSTALLED = 1,
    BF_DYNAMIC_UNSUPPORTED = 2
};

